// This is your Prisma schema file
// Prisma 7 - datasource url is in prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// --- User --------------------------------------------------------------------
// role: "ADMIN" | "MANAGER" | "AGENT"

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("AGENT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads Lead[] @relation("AssignedAgent")

  @@map("users")
}

// --- Lead --------------------------------------------------------------------
// source: "WEBSITE" | "ACRES_99" | "MAGICBRICKS" | "REFERRAL" | "WALK_IN" | "HOUSING_COM"
// status: "NEW" | "CONTACTED" | "SITE_VISIT" | "INTERESTED" | "NEGOTIATION" | "BOOKED" | "LOST"

model Lead {
  id         String    @id @default(cuid())
  name       String
  email      String?
  phone      String
  source     String
  status     String    @default("NEW")
  assignedTo String?
  notes      String?
  project    String?
  budget     String?
  followUp   DateTime?
  urgent     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  agent    User?     @relation("AssignedAgent", fields: [assignedTo], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@map("leads")
}

// --- Property ----------------------------------------------------------------
// type:   "APARTMENTS" | "VILLAS" | "PLOTS" | "COMMERCIAL"
// status: "READY_TO_MOVE" | "UNDER_CONSTRUCTION" | "NEW_LAUNCH" | "SOLD_OUT"

model Property {
  id             String   @id @default(cuid())
  name           String
  location       String
  type           String
  status         String   @default("UNDER_CONSTRUCTION")
  price          Float
  priceLabel     String
  bedrooms       String?
  area           String?
  description    String?
  totalUnits     Int      @default(0)
  availableUnits Int      @default(0)
  possessionDate String?
  bannerGradient String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings Booking[]

  @@map("properties")
}

// --- Booking -----------------------------------------------------------------
// status: "PENDING" | "CONFIRMED" | "CANCELLED"

model Booking {
  id          String   @id @default(cuid())
  leadId      String
  propertyId  String
  bookingDate DateTime
  amount      Float
  status      String   @default("PENDING")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("bookings")
}
